# Browsers that we support
# Target ONLY modern browsers with native ES2022+ support
# This eliminates unnecessary polyfills and reduces bundle size

# Modern desktop browsers with native Array.at, Object.hasOwn support
chrome >= 92
firefox >= 92
safari >= 15.4
edge >= 92

# Modern mobile browsers
ios_saf >= 15.4
android >= 92

# Explicitly exclude old browsers
not dead
not IE 11
not op_mini all
not android < 92
not samsung < 16
not safari < 15.4
not firefox < 92
not chrome < 92
not edge < 92
